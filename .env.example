# ── Backend API ─────────────────────────────────────
PORT=3000
NODE_ENV=development
# 실제 PostgreSQL을 쓰려면 설정한다. 비워 두면 .data/pglite 에 PGlite(내장 PostgreSQL)로 저장한다.
DATABASE_URL=
# PGLITE_DATA_DIR=.data/pglite
# 시작 시 마이그레이션 자동 적용
MIGRATE_ON_START=true
# 쿠키·CORS 허용 Origin (쉼표 구분). 개발 시 Vite 서버 주소.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# 세션 유효 시간(시간)
SESSION_TTL_HOURS=12

# ── 초기 소유자 계정 (pnpm db:seed) ─────────────────
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_DISPLAY_NAME=포트폴리오 소유자
SEED_SAMPLE_DATA=true

# ── GitHub 가져오기 (관리자 > Git 저장소 > GitHub에서 가져오기) ──
# 비공개 저장소까지 읽으려면 GitHub 토큰(무료). Fine-grained: Repository access=All, Metadata=Read-only
GITHUB_TOKEN=
# 토큰이 없을 때 공개 저장소만 읽을 GitHub 사용자 이름
GITHUB_USERNAME=
